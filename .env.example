# Copy this file to .env and fill in your own values. .env is gitignored: never commit real keys.

# Google Gemini (free tier): https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key-here

# LangSmith (free Developer plan): records each run of the price agent so you can inspect and evaluate it.
# Create a key at https://smith.langchain.com → Settings → API Keys. Leave LANGSMITH_TRACING=false to switch off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=mehngai-watch
# EU accounts only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
